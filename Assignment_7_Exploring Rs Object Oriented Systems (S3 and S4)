# Load mtcars dataset

data("mtcars")
head(mtcars)
str(mtcars)

# Test Generic Functions
# summary() and plot() are generics and mtcars is a data.frame, so they dispatch to summary.data.frame() and plot.data.frame()
summary(mtcars)
plot(mtcars)

# Explore S3 vs. S4
s3_obj <- list(name = "Myself", age = 29, GPA = 3.5)
class(s3_obj) <- "student_s3"

print.student_s3 <- function(x) {
  cat(x$name, x$age, x$GPA, "\n")
}
print(s3_obj)

setClass("student_s4",
         slots = c(name = "character", age = "numeric", GPA = "numeric"))
s4_obj <- new("student_s4", name = "Myself", age = 29, GPA = 3.5)

setMethod("show", "student_s4", function(object) {
  cat(object@name, object@age, object@GPA, "\n")
})
s4_obj
